{
  "mcpServers": {
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ],
      "env": {},
      "disabled": true,
      "autoApprove": [
        "fetch"
      ]
    },
    "figma": {
      "url": "https://mcp.figma.com/mcp",
      "type": "http",
      "disabled": false,
      "autoApprove": [
        "get_screenshot",
        "get_design_context",
        "get_metadata",
        "download_assets",
        "download_assets",
        "download_assets",
        "download_assets"
      ]
    }
  }
}